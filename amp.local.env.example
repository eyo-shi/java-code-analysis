# Copy to amp.local.env when the CML Configuration screen does not save edited values.
# amp.local.env is git-ignored. Values here override broken CML Configuration entries
# and are synced back to Project Settings via the CML API.

GIT_REPO_URL=https://github.com/terasolunaorg/terasoluna-tourreservation-mybatis3
GIT_REF=release/5.7.1.SP1.RELEASE
NEO4J_URI=bolt://cml-neo4j-xxxxx.namespace:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=Neo4jPass1234
